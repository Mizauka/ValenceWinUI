<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ValenceWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ValenceWinUI"
    xmlns:pages="using:ValenceWinUI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="ValenceWinUI"
            MinHeight="48"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            BackRequested="TitleBar_BackRequested"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
        </TitleBar>

        <!-- NavigationView + Frame -->
        <NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="1"
            Canvas.ZIndex="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="NavigationView_SelectionChanged"
            DisplayModeChanged="NavigationView_DisplayModeChanged"
            Loaded="NavigationView_Loaded">
            <Frame
                x:Name="ContentFrame"
                CacheSize="10"
                Navigated="ContentFrame_Navigated" />
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavPage1"
                    Content="页面一"
                    Tag="Page1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavPage2"
                    Content="页面二"
                    Tag="Page2"
                    Icon="Document" />
                <NavigationViewItem
                    x:Name="NavPage3"
                    Content="页面三"
                    Tag="Page3"
                    Icon="Pictures" />
                <NavigationViewItem
                    x:Name="NavPage4"
                    Content="页面四"
                    Tag="Page4"
                    Icon="Favorite" />
                <NavigationViewItem
                    x:Name="NavSettings"
                    Content="设置"
                    Tag="Settings"
                    Icon="Setting" />
            </NavigationView.MenuItems>
        </NavigationView>
    </Grid>
</Window>
